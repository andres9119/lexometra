{
  "name": "StateAutomation",
  "type": "object",
  "properties": {
    "process_state_id": {
      "type": "string",
      "description": "ID del estado que dispara la regla"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "change_color",
        "send_webhook",
        "send_email",
        "log_event"
      ],
      "description": "Tipo de acci\u00f3n autom\u00e1tica"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL destino para webhooks"
    },
    "webhook_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u00bfEst\u00e1 activa la regla?"
    },
    "order": {
      "type": "number",
      "description": "Orden de ejecuci\u00f3n de reglas"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la regla"
    },
    "retry_count": {
      "type": "number",
      "default": 3,
      "description": "N\u00famero de reintentos en caso de fallo"
    }
  },
  "required": [
    "process_state_id",
    "rule_type"
  ]
}