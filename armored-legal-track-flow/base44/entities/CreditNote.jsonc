{
  "name": "CreditNote",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "nota_credito",
        "nota_debito"
      ],
      "description": "Tipo de nota: cr\u00e9dito (reduce deuda) o d\u00e9bito (aumenta deuda)"
    },
    "value": {
      "type": "number",
      "description": "Valor del ajuste en COP"
    },
    "invoice_id": {
      "type": "string",
      "description": "ID de la factura afectada"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura afectada (desnormalizado)"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente (desnormalizado)"
    },
    "motivo_ajuste": {
      "type": "string",
      "description": "Descripci\u00f3n obligatoria del motivo del ajuste contable"
    },
    "created_by_id": {
      "type": "string",
      "description": "ID del usuario que cre\u00f3 el registro (auditor\u00eda)"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nombre del usuario creador (desnormalizado para auditor\u00eda)"
    }
  },
  "required": [
    "type",
    "value",
    "motivo_ajuste",
    "created_by_id"
  ]
}