# ── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lexometra.tudominio.com,www.lexometra.tudominio.com

# ── PostgreSQL ────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lexometra
DB_USER=lexometra_user
DB_PASSWORD=replace-with-secure-password
DB_HOST=localhost
DB_PORT=5432

# ── Email (SMTP para recuperación de contraseña, notificaciones) ──
EMAIL_HOST=smtp.tudominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@tudominio.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Lexometra <no-reply@tudominio.com>

# ── Seguridad HTTPS ──────────────────────────────────
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Factus (facturación electrónica DIAN) ────────────
# Dejar vacías usa las credenciales sandbox (solo desarrollo).
# Para producción define credenciales reales y el numbering_range_id de la resolución.
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_AUTH_URL=https://api-sandbox.factus.com.co/oauth/token
FACTUS_API_URL=https://api-sandbox.factus.com.co/v2
FACTUS_NUMBERING_RANGE_ID=
